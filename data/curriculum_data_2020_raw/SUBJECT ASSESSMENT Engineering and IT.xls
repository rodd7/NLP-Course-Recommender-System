   <Row>
    <Cell><Data ss:Type="String">42020</Data></Cell>
    <Cell><Data ss:Type="String">Structural Design for Blast Loads</Data></Cell>
    <Cell><Data ss:Type="String">Students are required to calculate a range of blast scenarios, analyse and discuss results and make well-justified conclusions and recommendations. Further details are provided on UTSOnline.</Data></Cell>
    <Cell><Data ss:Type="String">Report</Data></Cell>
    <Cell><Data ss:Type="String">Report</Data></Cell>
    <Cell><Data ss:Type="String">20</Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String">Individual</Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String">To provide students with practice in problem solving and applying concepts to real structures.</Data></Cell>
    <Cell><Data ss:Type="String">This is a scenario based project where students prepare a tender for calculating multiple explosion effects. Students develop a procedure to calculate blast loading, develop a spreadsheet to facilitate the calculation procedure and justify advice to the client. Further details are provided on UTSOnline.</Data></Cell>
    <Cell><Data ss:Type="String">Individual Project</Data></Cell>
    <Cell><Data ss:Type="String">Project</Data></Cell>
    <Cell><Data ss:Type="String">30</Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String">Individual</Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String">To allow students to demonstrate what they have learnt, to calculate Blast Loading Due to Multiple Explosions.</Data></Cell>
    <Cell><Data ss:Type="String">This is a group project. Students respond to a scenario based project requiring the preliminary design of an ultra-high performance concrete member against blast loadings. Further details are provided on UTSOnline.</Data></Cell>
    <Cell><Data ss:Type="String">Group Project</Data></Cell>
    <Cell><Data ss:Type="String">Project</Data></Cell>
    <Cell><Data ss:Type="String">50</Data></Cell>
