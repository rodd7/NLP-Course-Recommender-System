   <Row>
    <Cell><Data ss:Type="String">42913</Data></Cell>
    <Cell><Data ss:Type="String">Social and Information Network Analysis</Data></Cell>
    <Cell><Data ss:Type="String">Solve practical problems related to (1) graph theory and social networks, (2) graph models, and (3) network centrality and community, which are fundamental to industry practitioners.</Data></Cell>
    <Cell><Data ss:Type="String">Assignment 1 : Graph theory and network strucuture</Data></Cell>
    <Cell><Data ss:Type="String">Report</Data></Cell>
    <Cell><Data ss:Type="String">15</Data></Cell>
    <Cell><Data ss:Type="String">There is no word limit, but we expect assignments will be generally around 4-5 pages long.</Data></Cell>
    <Cell><Data ss:Type="String">Date/Time</Data></Cell>
