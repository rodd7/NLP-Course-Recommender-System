    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String">Week 12, 23pm Friday, 23rd Oct 2020</Data></Cell>
    <Cell><Data ss:Type="String">Week 12, 23pm Friday, 23rd Oct 2020</Data></Cell>
    <Cell><Data ss:Type="String">Group, individually assessed</Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String">Provide an opportunity for students to work in groups and learn to apply artificial intelligence techniques to solve small problems.</Data></Cell>
    <Cell><Data ss:Type="String">Students will answer all questions in the exam paper. Questions will involve application of skills and knowledge in order to complex AI problem contexts.</Data></Cell>
    <Cell><Data ss:Type="String">Final Exam</Data></Cell>
