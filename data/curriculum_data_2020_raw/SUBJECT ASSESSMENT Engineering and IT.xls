    <Cell><Data ss:Type="String">11.59pm Monday 25 May 2020</Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String">Individual</Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String">6 quizzes, each covering the topics of the preceeding two weeks.</Data></Cell>
