   <Row>
    <Cell><Data ss:Type="String">49122</Data></Cell>
    <Cell><Data ss:Type="String">Ecology and Sustainability</Data></Cell>
    <Cell><Data ss:Type="String">Essay Choose an area or industry, identify local environmental problems, identify constraints and risk of the system and propose immediate and long term (sustainable) solutions. Questions will be posted on UTSOnline under ‘Course Instruction and Assignments’ under the section of ‘Subject Information’. See UTSOnline</Data></Cell>
    <Cell><Data ss:Type="String">Assignment 1</Data></Cell>
    <Cell><Data ss:Type="String">Essay</Data></Cell>
    <Cell><Data ss:Type="String">12</Data></Cell>
    <Cell><Data ss:Type="String">See UTSOnline.</Data></Cell>
    <Cell><Data ss:Type="String">Custom</Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String">Submit to UTSOnline by 3 September 2019</Data></Cell>
    <Cell><Data ss:Type="String">Submit to UTSOnline by 3 September 2019</Data></Cell>
    <Cell><Data ss:Type="String">Individual</Data></Cell>
    <Cell><Data ss:Type="String">essay (qualitative and quantitative), identify environmental problems and propose sustainable solutions</Data></Cell>
    <Cell><Data ss:Type="String">Essay question on a project related to sustainable development.</Data></Cell>
    <Cell><Data ss:Type="String">Summative Assessment Local and global environmental problems, estimation of pollution, pollution remediation and solution.</Data></Cell>
    <Cell><Data ss:Type="String">Assignment 2</Data></Cell>
    <Cell><Data ss:Type="String">Exercises</Data></Cell>
    <Cell><Data ss:Type="String">12</Data></Cell>
