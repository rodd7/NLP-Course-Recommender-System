    <Cell><Data ss:Type="String">27 September</Data></Cell>
    <Cell><Data ss:Type="String">Individual</Data></Cell>
    <Cell><Data ss:Type="String">This assignment is an oral presentation. Students develop a genomics data analysis pipeline and process a single real-world dataset. This assessment includes a critical evaluation of the data analysis pipeline and an interpretation of results in the biological/medical context.</Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String">Group assignment with individual assessment.</Data></Cell>
    <Cell><Data ss:Type="String">Integrative genomics in action</Data></Cell>
    <Cell><Data ss:Type="String">Report</Data></Cell>
    <Cell><Data ss:Type="String">50</Data></Cell>
    <Cell><Data ss:Type="String">This is an assignment to be performed outside of class.</Data></Cell>
