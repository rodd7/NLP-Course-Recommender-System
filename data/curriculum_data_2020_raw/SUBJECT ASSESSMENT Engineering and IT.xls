   <Row>
    <Cell><Data ss:Type="String">42083</Data></Cell>
    <Cell><Data ss:Type="String">Studio 1 Project</Data></Cell>
    <Cell><Data ss:Type="String">Complete a technical modelling report following the traditional stages of the engineering paradigm: scope, research, design, implement, and communicate.</Data></Cell>
    <Cell><Data ss:Type="String">Group assignment</Data></Cell>
    <Cell><Data ss:Type="String">Project</Data></Cell>
    <Cell><Data ss:Type="String">40</Data></Cell>
    <Cell><Data ss:Type="String">Approximately 5000 words</Data></Cell>
    <Cell><Data ss:Type="String">Custom</Data></Cell>
