   <Row>
    <Cell><Data ss:Type="String">49048</Data></Cell>
    <Cell><Data ss:Type="String">Wireless Access Network Technologies</Data></Cell>
    <Cell><Data ss:Type="String">An online quiz using UTSOnline will be held in class during the weeks indicated in the subject program. Students will attempt the quiz individiaully.</Data></Cell>
    <Cell><Data ss:Type="String">Term Exam</Data></Cell>
    <Cell><Data ss:Type="String">Quiz/test</Data></Cell>
    <Cell><Data ss:Type="String">20</Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
