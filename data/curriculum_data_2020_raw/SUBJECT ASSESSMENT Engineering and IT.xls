   <Row>
    <Cell><Data ss:Type="String">48621</Data></Cell>
    <Cell><Data ss:Type="String">Manufacturing Engineering</Data></Cell>
    <Cell><Data ss:Type="String">Each student is asked to organise an individual written report based on the investigations on the fabrication processes of a relatively simple industrial product discussed in the lab classes. Typical examples include Engine Block and Trolley Jack etc.</Data></Cell>
    <Cell><Data ss:Type="String">Minor Project</Data></Cell>
    <Cell><Data ss:Type="String">Project</Data></Cell>
    <Cell><Data ss:Type="String">10</Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
