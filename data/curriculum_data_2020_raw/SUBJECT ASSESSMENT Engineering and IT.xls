   <Row>
    <Cell><Data ss:Type="String">32567</Data></Cell>
    <Cell><Data ss:Type="String">Business Intelligence for Decision Support</Data></Cell>
    <Cell><Data ss:Type="String">This mark is based on the quality of students’ post and engagement in discussion.</Data></Cell>
    <Cell><Data ss:Type="String">Discussion post</Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String">5</Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String">Week range</Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String">Week 1 to Week 12</Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String">Individual</Data></Cell>
