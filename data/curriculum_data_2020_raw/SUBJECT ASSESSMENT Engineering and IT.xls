    <Cell><Data ss:Type="String">Week 9              This class exam will be held during lecture. Do not come late to your lecture.</Data></Cell>
    <Cell><Data ss:Type="String">Individual</Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String">Test data integrity skills.</Data></Cell>
    <Cell><Data ss:Type="String">This class exam will be held during lecture. Do not come late to your lecture.</Data></Cell>
    <Cell><Data ss:Type="String">Database ERD test.</Data></Cell>
    <Cell><Data ss:Type="String">Distinction Exam</Data></Cell>
    <Cell><Data ss:Type="String">Examination</Data></Cell>
    <Cell><Data ss:Type="String">20</Data></Cell>
