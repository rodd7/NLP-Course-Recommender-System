   <Row>
    <Cell><Data ss:Type="String">32144</Data></Cell>
    <Cell><Data ss:Type="String">Technology Research Preparation</Data></Cell>
    <Cell><Data ss:Type="String">Demonstrate an independent approach to the mastery of foundational research skills. Contribute to in-class discussions.</Data></Cell>
    <Cell><Data ss:Type="String">Building Research Skills</Data></Cell>
    <Cell><Data ss:Type="String">Exercises</Data></Cell>
    <Cell><Data ss:Type="String">10</Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
