    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String">16/09/2019, 11:59pm</Data></Cell>
    <Cell><Data ss:Type="String">16/09/2019, 11:59pm</Data></Cell>
    <Cell><Data ss:Type="String">Individual</Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String">Students will work as a team to smoke test a system. This involves planning, documentation, cooperation and collaboration culminating with a presentation to peers. There is an individual component where students create and submit cases (see criteria linkages below).</Data></Cell>
    <Cell><Data ss:Type="String">Smoke Test</Data></Cell>
    <Cell><Data ss:Type="String">Report</Data></Cell>
    <Cell><Data ss:Type="String">30</Data></Cell>
