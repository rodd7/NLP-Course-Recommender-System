    <Cell><Data ss:Type="String">Individual</Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String">The final exam assesses the students’ understanding and ability to apply the theoretical underpinnings of computer science.</Data></Cell>
