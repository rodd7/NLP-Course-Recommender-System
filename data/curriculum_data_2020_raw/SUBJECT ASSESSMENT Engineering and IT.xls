   <Row>
    <Cell><Data ss:Type="String">41042</Data></Cell>
    <Cell><Data ss:Type="String">Introduction to Computational Intelligence</Data></Cell>
    <Cell><Data ss:Type="String">Students will use the mathematical symbol/equation to derive and proceed to solution during the class</Data></Cell>
    <Cell><Data ss:Type="String">Exercises on computational intelligent methods</Data></Cell>
    <Cell><Data ss:Type="String">Exercises</Data></Cell>
    <Cell><Data ss:Type="String">15</Data></Cell>
    <Cell><Data ss:Type="String">Submission: An A4 answer sheet for the exercise</Data></Cell>
    <Cell><Data ss:Type="String">Custom</Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
