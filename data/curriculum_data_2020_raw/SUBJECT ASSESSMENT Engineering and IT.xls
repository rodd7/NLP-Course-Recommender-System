   <Row>
    <Cell><Data ss:Type="String">48520</Data></Cell>
    <Cell><Data ss:Type="String">Electronics and Circuits</Data></Cell>
    <Cell><Data ss:Type="String">Weekly submission of solutions to unique problems related to each lecture topic</Data></Cell>
    <Cell><Data ss:Type="String">WebTutor Exercises</Data></Cell>
    <Cell><Data ss:Type="String">Exercises</Data></Cell>
    <Cell><Data ss:Type="String">35</Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
