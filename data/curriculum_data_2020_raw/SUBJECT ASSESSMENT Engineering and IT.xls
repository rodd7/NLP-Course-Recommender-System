   <Row>
    <Cell><Data ss:Type="String">41903</Data></Cell>
    <Cell><Data ss:Type="String">Internet Science</Data></Cell>
    <Cell><Data ss:Type="String">To write a report whose structure allows students to learn the role of a reviewer, to practice the inevitable self-learning required, and to demonstrate an ability to demonstrate initiative in going deeper.</Data></Cell>
    <Cell><Data ss:Type="String">Research Review</Data></Cell>
    <Cell><Data ss:Type="String">Report</Data></Cell>
    <Cell><Data ss:Type="String">30</Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String">Date/Time</Data></Cell>
