   <Row>
    <Cell><Data ss:Type="String">41002</Data></Cell>
    <Cell><Data ss:Type="String">Professional Engineering Practice Preparation</Data></Cell>
    <Cell><Data ss:Type="String">Students must complete a quiz to ensure their understanding of basic knowledge on workplace health and safety, ethics and industrial issues.</Data></Cell>
    <Cell><Data ss:Type="String">Individual Quiz</Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String">5</Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String">Week</Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String">6</Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String">Week 6              Students will be provided in advance with additional instructions.</Data></Cell>
    <Cell><Data ss:Type="String">Students will be provided in advance with additional instructions.</Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String">To ensure they have learned to stay abreast of workplace health and safety, and industrial issues, students are assessed for their ability to identify and access selected material from credible information sources.</Data></Cell>
    <Cell><Data ss:Type="String">Students participate in a group presentation relating to their major project.</Data></Cell>
    <Cell><Data ss:Type="String">Group Presentation</Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String">15</Data></Cell>
