    <Cell><Data ss:Type="String">This item is provides students with an opportunity to demonstrate their competence in oral communication.</Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String">Research Logbook/Diary</Data></Cell>
