   <Row>
    <Cell><Data ss:Type="String">41120</Data></Cell>
    <Cell><Data ss:Type="String">Work Integrated Learning (BIT)</Data></Cell>
    <Cell><Data ss:Type="String">Students will produce a short report on their work project proposal.</Data></Cell>
    <Cell><Data ss:Type="String">Project Proposal</Data></Cell>
    <Cell><Data ss:Type="String">Report</Data></Cell>
    <Cell><Data ss:Type="String">5</Data></Cell>
    <Cell><Data ss:Type="String">Final report: 300-500 words</Data></Cell>
    <Cell><Data ss:Type="String">Week</Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String">1</Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String">Week 1</Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String">Individual</Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String">Provide information to subject coach to evaluate the suitability of project and SFIA skills being developed.</Data></Cell>
    <Cell><Data ss:Type="String">Student will provide a Planning Proposal including research methodologies to be used in the project.</Data></Cell>
    <Cell><Data ss:Type="String">Project plan including methodology for evaluation</Data></Cell>
    <Cell><Data ss:Type="String">Report</Data></Cell>
    <Cell><Data ss:Type="String">15</Data></Cell>
    <Cell><Data ss:Type="String">1000-1500 words</Data></Cell>
    <Cell><Data ss:Type="String">Week</Data></Cell>
