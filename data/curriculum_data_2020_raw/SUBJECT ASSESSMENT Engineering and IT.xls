    <Cell><Data ss:Type="String">Individual</Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String">To allow students to use enquiry and reflective learning.</Data></Cell>
    <Cell><Data ss:Type="String">Exercises, topics and situations will be posed for students to comment on and debate. 5 sets of discussion/debates spread throughout the session.</Data></Cell>
    <Cell><Data ss:Type="String">Online Engagement</Data></Cell>
    <Cell><Data ss:Type="String">Exercises</Data></Cell>
    <Cell><Data ss:Type="String">10</Data></Cell>
    <Cell><Data ss:Type="String">N/A</Data></Cell>
