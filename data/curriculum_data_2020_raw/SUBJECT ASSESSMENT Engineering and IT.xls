   <Row>
    <Cell><Data ss:Type="String">41171</Data></Cell>
    <Cell><Data ss:Type="String">Quantum Computer Architectures</Data></Cell>
    <Cell><Data ss:Type="String">Extended tutorial exercise</Data></Cell>
    <Cell><Data ss:Type="String">Resource Estimation case study</Data></Cell>
    <Cell><Data ss:Type="String">Exercises</Data></Cell>
    <Cell><Data ss:Type="String">20</Data></Cell>
    <Cell><Data ss:Type="String">2-3 hours</Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
