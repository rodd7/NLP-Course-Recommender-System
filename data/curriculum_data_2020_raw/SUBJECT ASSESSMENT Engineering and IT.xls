    <Cell><Data ss:Type="String">15/10/2019</Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String">11:59 PM</Data></Cell>
    <Cell><Data ss:Type="String">11.59pm Tuesday 15 October 2019</Data></Cell>
    <Cell><Data ss:Type="String">Group, individually assessed</Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String">Demonstration of team’s and individual’s ability to develop realistic and functional finite element models of musculoskeletal joints in the human body.</Data></Cell>
