    <Cell><Data ss:Type="String">Date, time and venue will be scheduled towards the end of session.</Data></Cell>
    <Cell><Data ss:Type="String">Individual</Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String">To test the understanding of concepts covered in the subject and working through the business plan.</Data></Cell>
