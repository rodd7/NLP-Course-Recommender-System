    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String">Demonstrate the ability to understand the theory and practice of software development.</Data></Cell>
    <Cell><Data ss:Type="String">Not applicable; see weekly schedule.</Data></Cell>
