    <Cell><Data ss:Type="String">Custom</Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String">Video link and transcript due on 14/10/2019 11am in Turnitin via UTSOnline; Video presentation in class on 14/10/2019.</Data></Cell>
    <Cell><Data ss:Type="String">Video link and transcript due on 14/10/2019 11am in Turnitin via UTSOnline; Video presentation in class on 14/10/2019.</Data></Cell>
    <Cell><Data ss:Type="String">Individual</Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String">Demonstrate effective communication skills enabling presentation of innovative solutions and ideas to a range of audiences.</Data></Cell>
