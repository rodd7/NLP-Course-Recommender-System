   <Row>
    <Cell><Data ss:Type="String">41097</Data></Cell>
    <Cell><Data ss:Type="String">Software Engineering Studio 3A</Data></Cell>
    <Cell><Data ss:Type="String">The task for students is to explore users’ needs, to demonstrate the high-level systematic software engineering synthesis and design process and to have reasonable project management.</Data></Cell>
    <Cell><Data ss:Type="String">Project pitch and planning</Data></Cell>
    <Cell><Data ss:Type="String">Presentation</Data></Cell>
    <Cell><Data ss:Type="String">10</Data></Cell>
