   <Row>
    <Cell><Data ss:Type="String">42026</Data></Cell>
    <Cell><Data ss:Type="String">Biomedical Polymers</Data></Cell>
    <Cell><Data ss:Type="String">Students will be required to take lab notes on LabArchives. These notes will need to be downloaded and then uploaded on CANVAS for marking.</Data></Cell>
