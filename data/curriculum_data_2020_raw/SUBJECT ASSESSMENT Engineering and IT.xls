    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String">UTS Exam period</Data></Cell>
    <Cell><Data ss:Type="String">Individual</Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String">This is the Final Exam. It is intended to assess the students' knowledge of embedded processor, hardware I/O interfaces, and programming skills.</Data></Cell>
